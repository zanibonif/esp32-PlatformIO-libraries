  "authors": [
    {
      "name": "Filippo Maria Zaniboni",
      "email": "filippo.zaniboni.88@gmail.com"
    }
  ],
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "dependencies": [
